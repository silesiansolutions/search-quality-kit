{
  "name": "@silesiansolutions/search-quality-kit",
  "version": "0.14.0",
  "description": "Framework-agnostic CLI for auditing technical Google Search foundations in local builds and CI.",
  "type": "module",
  "bin": {
    "search-quality-kit": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils.d.ts",
      "import": "./dist/test-utils.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "seo",
    "google-search",
    "technical-seo",
    "seo-audit",
    "hreflang",
    "sitemap",
    "structured-data",
    "llms-txt",
    "crawler",
    "sarif",
    "github-action",
    "ci",
    "cli",
    "quality"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silesiansolutions/search-quality-kit.git"
  },
  "bugs": {
    "url": "https://github.com/silesiansolutions/search-quality-kit/issues"
  },
  "homepage": "https://www.npmjs.com/package/@silesiansolutions/search-quality-kit",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
